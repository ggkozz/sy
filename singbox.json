      "idle_timeout": "30m"
    },
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "auto",
        "r-CA",
        "r-DE",
        "r-ES",
        "r-FR",
        "r-HK",
        "r-IR",
        "r-JP",
        "r-NL",
        "r-SG",
        "r-US",
        "asia",
        "west",
        "direct"
      ],
      "default": "auto"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "final": "proxy",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "localdns"
    }
  }
}